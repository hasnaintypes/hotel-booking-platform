# Copy to .env (gitignored). Must match the backend origin (default 5001).
VITE_API_BASE_URL=http://localhost:5001

# Public site used for "View site" and hotel/review deep links.
VITE_WEB_URL=http://localhost:5174

# Error tracking. Leave empty to disable; the SDK is loaded lazily after first paint, so it never
# affects the entry bundle. Set VITE_APP_RELEASE to the deployed git tag so reports match traces.
# VITE_SENTRY_DSN=https://public_key@o0.ingest.sentry.io/0
# VITE_APP_RELEASE=admin@1.0.0
