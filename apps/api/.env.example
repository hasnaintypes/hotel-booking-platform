# ================================================
# Hotel Booking Backend - Environment Variables
# ================================================
# Copy this file to .env and fill in your values

# ================================================
# SERVER CONFIGURATION
# ================================================
# Canonical local port (must match frontend VITE_API_BASE_URL and Google OAuth redirect URI)
PORT=5001

# Node environment (development, production, test)
NODE_ENV=development

# ================================================
# DATABASE CONFIGURATION
# ================================================
# PostgreSQL. Local setup: `docker compose up -d postgres`.
# DATABASE_URL is the runtime and migration target: hotel_booking locally; set staging/production
# to their own provider-assigned database and never share it between environments.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hotel_booking
# Tests reset this disposable database; never point it at local development or shared data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hotel_booking_test

# PostgreSQL pool and timeout defaults (whole numbers, milliseconds except pool size).
# Keep DATABASE_POOL_MAX x API instances below the database connection limit.
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=5000
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
# DATABASE_LOCK_TIMEOUT_MS=3000

# ================================================
# BACKGROUND JOBS (pg-boss + transactional outbox)
# ================================================
# In-process worker. Leave unset/false for an API-only process; run `pnpm --filter @hotel-booking/api start:worker`
# (or set RUN_WORKER=true on one API replica) to drain the outbox and run scheduled jobs.
# RUN_WORKER=true
# pg-boss installs its own schema; change this only if the database needs a different namespace.
# PGBOSS_SCHEMA=pgboss
# JOB_OUTBOX_POLL_MS=1000
# JOB_OUTBOX_BATCH_SIZE=25
# JOB_OUTBOX_MAX_ATTEMPTS=10
# JOB_OUTBOX_RETRY_DELAY_MS=5000
# JOB_OUTBOX_RETRY_DELAY_MAX_MS=300000
# JOB_OUTBOX_LOCK_TIMEOUT_MS=60000
# JOB_RETRY_LIMIT=3
# JOB_RETRY_DELAY_SECONDS=5
# JOB_RETRY_DELAY_MAX_SECONDS=300
# JOB_EXPIRE_SECONDS=900
# JOB_DELETE_AFTER_SECONDS=604800
# JOB_DEAD_LETTER_SUFFIX=.dead-letter
# JOB_LOCAL_CONCURRENCY=5
# JOB_POLL_INTERVAL_SECONDS=2
# JOB_SHUTDOWN_TIMEOUT_MS=30000
# JOB_RETENTION_DAYS=30
# JOB_PAYMENT_HOLD_MINUTES=30
# JOB_AUTHORIZED_STALE_MINUTES=15
# JOB_CONFIRMING_STALE_MINUTES=15
# JOB_CANCELLING_STALE_MINUTES=60
# JOB_SWEEP_BATCH_SIZE=100
# JOB_RECONCILE_LOOKBACK_HOURS=48
# JOB_RECONCILE_BATCH_SIZE=200
# JOB_MISSING_PROVIDER_GRACE_MINUTES=60
# JOB_LEDGER_LOOKBACK_DAYS=30
# JOB_LEDGER_BATCH_SIZE=1000
# JOB_EXPIRY_CRON=*/5 * * * *
# JOB_SWEEP_CRON=*/10 * * * *
# JOB_RECONCILE_CRON=*/15 * * * *
# JOB_LEDGER_CRON=0 3 * * *
# JOB_CLEANUP_CRON=0 * * * *

# Demo seeding (optional; used only by `pnpm --filter @hotel-booking/api seed`).
# There is no default password. Local databases need no extra flags.
# SEED_PASSWORD=choose-a-strong-demo-password
# ALLOW_SEED=true
# SEED_DATABASE_NAME=hotel_booking_staging

# ================================================
# AUTHENTICATION & SECURITY
# ================================================
# JWT Secret Key (use a strong, random string)
# Generate with: openssl rand -base64 512
JWT_SECRET_KEY=your_jwt_secret_key_here

# ================================================
# FRONTEND & BACKEND CONFIGURATION
# ================================================
# Frontend URL for CORS (your React app URL)
# Local development: http://localhost:5174
# Production: https://your-frontend-domain.example.com
FRONTEND_URL=http://localhost:5174

# Admin console URL for the CORS/origin allow-list (apps/admin)
# Local development: http://localhost:5175 (default when unset)
# Production: https://your-admin-domain.example.com
ADMIN_URL=http://localhost:5175

# Backend public URL (OAuth redirect_uri = {BACKEND_URL}/api/v1/auth/oauth/google/callback)
# Local: leave unset (uses http://localhost:PORT). Add same URI in Google Console if using Google sign-in.
# Production: https://your-backend-domain.example.com
# BACKEND_URL=https://your-backend-domain.example.com

# Google OAuth - register redirect URI in Google Cloud Console (see modules/auth + config/env.validation.ts)
GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_SECRET=your_google_client_secret

# ================================================
# CLOUDINARY CONFIGURATION
# ================================================
# Cloudinary credentials for image storage
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Folder for hotel images. Default: hotel-booking/<NODE_ENV>, so environments never share uploads.
# CLOUDINARY_FOLDER=hotel-booking/development

# ================================================
# STRIPE PAYMENT CONFIGURATION
# ================================================
# Stripe API key for payment processing
# Get from: https://dashboard.stripe.com/apikeys
# Use a test key: sk_test_...
# Live keys (sk_live_...) are refused when NODE_ENV=production until milestone M2:
# payments and bookings are not production-ready yet.
# Same secret key is used for PaymentIntents and refunds (stripe.refunds.create)
STRIPE_API_KEY=your_stripe_secret_key_here
# Signing secret for POST /webhooks/stripe. Get it from the Stripe CLI
# (`stripe listen --forward-to localhost:5001/webhooks/stripe`) or the dashboard webhook
# endpoint. Required: the API refuses to start without it.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# Reject signatures older than this many seconds (default 300). Set 0 to disable the check.
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Consecutive processing failures for one event before an alert-level log line (default 5).
# STRIPE_WEBHOOK_FAILURE_ALERT_THRESHOLD=5

# ================================================
# OPTIONAL CONFIGURATION
# ================================================
# Longest bookable stay in nights (whole number, 1 to 365)
# BOOKING_MAX_NIGHTS=30

# HTTP idempotency store. Stored responses are replayable for 24-72 hours; the lease
# releases a key held by a crashed request after 1-300 seconds.
# IDEMPOTENCY_TTL_HOURS=48
# IDEMPOTENCY_LOCK_TIMEOUT_MS=30000

# AI assist (draft-and-approve only — never auto-saves). Server-side only.
# Failover chain: Groq models → OpenAI → OpenRouter → stub (on 429/5xx).
# Each request calls a paid provider and sends the user's text to it. Off unless set to true.
# AI_ASSIST_ENABLED=true
# Per-user limits (in memory: reset on restart) and the deadline for one request, in milliseconds
# AI_DAILY_QUOTA=20
# AI_PER_MINUTE_LIMIT=5
# AI_REQUEST_DEADLINE_MS=30000
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=               # optional override; default chain: gpt-oss-20b → qwen3.6-27b → gpt-oss-120b
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=         # optional single override
