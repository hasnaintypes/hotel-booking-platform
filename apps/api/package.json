{
  "name": "@hotel-booking/api",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "description": "Hotel booking platform API",
  "main": "./dist/apps/api/src/main.js",
  "scripts": {
    "build": "nest build",
    "clean": "rm -rf dist",
    "dev": "pnpm --filter @hotel-booking/db build && nest start --watch --entryFile ../apps/api/src/main",
    "gen:controller": "node scripts/new-controller.mjs",
    "lint": "eslint . --max-warnings 0",
    "openapi:check": "vitest run test/openapi-snapshot.e2e-spec.ts",
    "openapi:generate": "UPDATE_OPENAPI=1 vitest run test/openapi-snapshot.e2e-spec.ts",
    "seed": "tsx src/database/seeds/seed.ts",
    "start": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/api/src/worker.js",
    "test": "vitest run",
    "test:resilience": "vitest run test/m2-acceptance.e2e-spec.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json"
  },
  "dependencies": {
    "@hotel-booking/contracts": "workspace:*",
    "@hotel-booking/db": "workspace:*",
    "@hotel-booking/pricing": "workspace:*",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nestjs-pino": "^5.3.2",
    "nestjs-zod": "^5.6.0",
    "pg-boss": "12.38.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.11",
    "@swc/core": "^1.16.22",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
