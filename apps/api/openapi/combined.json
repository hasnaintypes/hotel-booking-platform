    "/api/v1/hotels/search": {
      "get": {
        "operationId": "HotelsController_search_v1",
        "parameters": [
          {
            "in": "query",
            "name": "destination",
            "required": false,
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "adultCount",
            "required": false,
            "schema": {
              "maximum": 50,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "childCount",
            "required": false,
            "schema": {
              "maximum": 50,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "facilities",
            "required": false,
            "schema": {
              "items": {
                "maxLength": 50,
                "type": "string"
              },
              "maxItems": 30,
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "types",
            "required": false,
            "schema": {
              "items": {
                "maxLength": 50,
                "type": "string"
              },
              "maxItems": 30,
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "stars",
            "required": false,
            "schema": {
              "items": {
                "maximum": 5,
                "minimum": 1,
                "type": "integer"
              },
              "maxItems": 5,
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "maxPrice",
            "required": false,
            "schema": {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sortOption",
            "required": false,
            "schema": {
              "enum": [
                "starRating",
                "pricePerNightAsc",
                "pricePerNightDesc"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotelSearchResponseDto_Output"
                }
              }
            },
            "description": "Active hotels matching the filters"
          }
        },
        "tags": [
          "Hotels"
        ]
      }
    },
