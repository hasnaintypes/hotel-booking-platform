{
  "components": {
    "schemas": {
      "BookingPageDto_Output": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "_id": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string"
                },
                "adultCount": {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "allowedTransitions": {
                  "items": {
                    "enum": [
                      "pending_payment",
                      "authorized",
                      "confirming",
                      "confirmed",
                      "cancelling",
                      "cancelled",
                      "failed",
                      "expired",
                      "needs_review"
                    ],
                    "type": "string"
                  },
                  "type": "array"
                },
                "cancellationReason": {
                  "type": "string"
                },
                "checkIn": {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                  "type": "string"
                },
                "checkOut": {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                  "type": "string"
                },
                "childCount": {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "createdAt": {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "firstName": {
                  "type": "string"
                },
                "hotelId": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string"
                },
                "inventorySource": {
                  "enum": [
                    "managed",
                    "supplier"
                  ],
                  "type": "string"
                },
                "lastName": {
                  "type": "string"
                },
                "offerId": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string"
                },
                "paymentMethod": {
                  "type": "string"
                },
                "paymentStatus": {
                  "enum": [
                    "pending",
                    "paid",
                    "failed",
                    "refunded"
                  ],
                  "type": "string"
                },
                "phone": {
                  "type": "string"
                },
                "publicReference": {
                  "type": "string"
                },
                "refundAmount": {
                  "type": "number"
                },
                "specialRequests": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pending_payment",
                    "authorized",
                    "confirming",
                    "confirmed",
                    "cancelling",
                    "cancelled",
                    "failed",
                    "expired",
                    "needs_review"
                  ],
                  "type": "string"
                },
                "stripePaymentIntentId": {
                  "type": "string"
                },
                "totalCost": {
                  "type": "number"
                },
                "updatedAt": {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                  "type": "string"
                },
                "userId": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string"
                }
              },
              "required": [
                "_id",
                "publicReference",
                "userId",
                "hotelId",
                "firstName",
                "lastName",
                "email",
                "adultCount",
                "childCount",
                "checkIn",
                "checkOut",
                "totalCost",
                "status",
                "allowedTransitions",
                "paymentStatus",
                "refundAmount",
                "createdAt",
                "updatedAt"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "pageInfo": {
            "additionalProperties": false,
            "properties": {
              "hasMore": {
                "type": "boolean"
              },
              "nextCursor": {
                "nullable": true,
                "type": "string"
              }
            },
            "required": [
              "nextCursor",
              "hasMore"
            ],
            "type": "object"
          }
        },
        "required": [
          "data",
          "pageInfo"
        ],
        "type": "object"
      },
      "HotelFormDto": {
        "properties": {},
        "type": "object"
      },
      "SuggestDto": {
        "properties": {},
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
